        </aapt:attr>
    </path>
    <!-- Glowing sun halo on left third -->
    <path android:pathData="M95,88 m-54,0 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="95"
