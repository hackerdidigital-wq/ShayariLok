        </aapt:attr>
    </path>
    <path
        android:fillColor="#55FFD27D"
        android:pathData="M45,122 H145 L138,125 H52 Z M62,130 H128 L122,133 H68 Z M75,138 H115 L110,140 H80 Z" />
