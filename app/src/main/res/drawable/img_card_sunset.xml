                android:endY="180"
                android:startX="40"
                android:startY="10"
                android:type="linear">
                <item android:color="#FFB84D" android:offset="0.0" />
                <item android:color="#E85D2C" android:offset="0.38" />
                <item android:color="#4B193D" android:offset="0.72" />
                <item android:color="#110B18" android:offset="1.0" />
